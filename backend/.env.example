# URI de conexão do MongoDB
MONGO_URI=mongodb://root:example@localhost:27111/oauth-webauthn?authSource=admin

# --- Configurações do WebAuthn (Relying Party) ---
# Nome da sua aplicação que será exibido para o usuário
RP_NAME="Meu Servidor OAuth"
# Domínio onde o frontend que usa WebAuthn está rodando (sem porta para produção)
RP_ID="localhost"
# Origem completa do frontend (com protocolo e porta para desenvolvimento)
EXPECTED_ORIGIN="http://localhost:5173"

# --- Configurações de Segurança ---
# Chave secreta para assinar os JSON Web Tokens (JWT)
JWT_SECRET="UMA_CHAVE_SECRETA_MUITO_LONGA_E_SEGURA_AQUI_PARA_JWT"
# Chave secreta para criptografar os cookies de sessão
SESSION_SECRET="OUTRA_CHAVE_SECRETA_MUITO_LONGA_PARA_SESSOES"